# Copy this to .env.local (gitignored) and fill in real values.
# Only needed when RUNNING npm run generate-audio to produce MP3s.
# The deployed app does NOT need this at runtime — MP3s are shipped as static files.

ELEVENLABS_API_KEY=sk_your_key_here

# Optional overrides:
# ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x   # Aria (default). Try others:
#                                              EXAVITQu4vr4xnSDxMaL = Sarah
#                                              21m00Tcm4TlvDq8ikWAM = Rachel
#                                              pFZP5JQG7iQjIQuC4Bku = Lily (British)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2  # multilingual v2 (default)
# FORCE=true                                  # re-generate everything (default: skip existing)
